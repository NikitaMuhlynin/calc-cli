file(READ "${BUILD_DIRECTORY}/compile_commands.json" commands)
string(JSON command_count LENGTH "${commands}")
math(EXPR last_command "${command_count} - 1")
set(sources)
foreach(index RANGE 0 ${last_command})
    string(JSON source GET "${commands}" ${index} file)
    cmake_path(CONVERT "${source}" TO_CMAKE_PATH_LIST source NORMALIZE)
    cmake_path(IS_PREFIX SOURCE_DIRECTORY "${source}" NORMALIZE in_project)
    file(RELATIVE_PATH relative_source "${SOURCE_DIRECTORY}" "${source}")
    if(in_project AND relative_source MATCHES "^(src|plugins|tests)/.*\\.cpp$")
        list(APPEND sources "${source}")
    endif()
endforeach()
list(REMOVE_DUPLICATES sources)
if(NOT sources)
    message(FATAL_ERROR "No project sources found in compile_commands.json")
endif()
list(LENGTH sources source_count)
foreach(source IN LISTS sources)
    execute_process(COMMAND "${CLANG_TIDY}" "-p=${BUILD_DIRECTORY}" --quiet "${source}"
        RESULT_VARIABLE status TIMEOUT 60)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "clang-tidy failed for ${source}")
    endif()
endforeach()
message(STATUS "clang-tidy checked ${source_count} project translation units")
