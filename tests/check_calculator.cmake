file(MAKE_DIRECTORY "${WORK_DIRECTORY}")

function(check_case name input expected_output expected_status)
    set(input_path "${WORK_DIRECTORY}/${name}.txt")
    file(WRITE "${input_path}" "${input}")
    execute_process(
        COMMAND "${CALC_EXECUTABLE}"
        INPUT_FILE "${input_path}"
        OUTPUT_VARIABLE output
        ERROR_VARIABLE error_output
        RESULT_VARIABLE status
        TIMEOUT 5
    )
    string(REPLACE "\r\n" "\n" output "${output}")
    if(NOT "${status}" STREQUAL "${expected_status}")
        message(FATAL_ERROR "${name}: expected exit ${expected_status}, got ${status}: ${error_output}")
    endif()
    if(NOT "${output}" STREQUAL "${expected_output}")
        message(FATAL_ERROR "${name}: expected output [${expected_output}], got [${output}]")
    endif()
    if(expected_status EQUAL 0 AND NOT error_output STREQUAL "")
        message(FATAL_ERROR "${name}: unexpected diagnostic: ${error_output}")
    elseif(NOT expected_status EQUAL 0 AND NOT error_output MATCHES "Error: .+")
        message(FATAL_ERROR "${name}: expected an error diagnostic, got [${error_output}]")
    endif()
endfunction()

if(SUITE STREQUAL "arithmetic")
    check_case(spec "16 + 4 * (3 - 1)\n" "24\n" 0)
    check_case(precedence "2+3*4\n(2+3)*4\n8/2*3\n10-3-2\n" "14\n20\n12\n5\n" 0)
    check_case(decimals "1.5 + .5\n5./2\n1e2+2.5E-1*4\n" "2\n2.5\n101\n" 0)
    check_case(unary "-2*3\n-(2+3)\n2*-3\n--2\n2--3\n2/-2\n+2\n-0\n" "-6\n-5\n-6\n2\n5\n-1\n2\n0\n" 0)
    check_case(whitespace " \t 2\t+\t3 \r\n" "5\n" 0)
    check_case(nesting "1+(2*(3+(4/2)))\n" "11\n" 0)
    check_case(division "7/2\n0/2\n" "3.5\n0\n" 0)
    string(REPEAT "(" 2000 opening)
    string(REPEAT ")" 2000 closing)
    check_case(deep_nesting "${opening}2${closing}\n" "2\n" 0)
    string(REPEAT "-" 2000 signs)
    check_case(long_unary "${signs}2\n" "2\n" 0)
elseif(SUITE STREQUAL "invalid")
    foreach(expression IN ITEMS "1+" "*2" "()" "(1+2" "1+2)" "2(3)" "1 2" "1..2" "." "1e" "1e+" "unknown(0)" "2$3" "2/**3" "1,5" "0x10" "nan" "inf")
        string(MD5 name "${expression}")
        check_case("syntax_${name}" "${expression}\n" "" 1)
    endforeach()
    foreach(expression IN ITEMS "1/0" "0/0" "1/(-0)" "2/(1-1)" "1e309" "1e308*10" "1e308+1e308")
        string(MD5 name "${expression}")
        check_case("numeric_${name}" "${expression}\n" "" 1)
    endforeach()
elseif(SUITE STREQUAL "console")
    check_case(eof "" "" 0)
    check_case(blank_lines "\n \t\n2+2\n\n" "4\n" 0)
    check_case(no_final_newline "2+3" "5\n" 0)
    check_case(recovery "1+\n2+2\n1/0\n3*3\n" "4\n9\n" 1)
elseif(SUITE STREQUAL "math")
    check_case(plugin_example "2^4 + sin(90)\n" "17\n" 0)
    check_case(power_precedence "2^3^2\n-2^2\n(-2)^2\n2^-2\n2^-2^2\n2^3*4+1\n2*3^2\n(-2)^3\n0^0\n" "512\n-4\n4\n0.25\n0.0625\n33\n18\n-8\n1\n" 0)
    check_case(degrees "sin(0)\nsin(90)\nsin(180)\nsin(-90)\nsin(450)\nsin(90+180)\nsin(90)^2+sin(0)\n" "0\n1\n0\n-1\n1\n-1\n1\n" 0)
    check_case(plugin_errors "(-2)^0.5\n0^-1\n1e308^2\nsin()\nsin(1,2)\n2^\nsin(90)\n" "1\n" 1)
else()
    message(FATAL_ERROR "Unknown test suite: ${SUITE}")
endif()
